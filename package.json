{
  "name": "fast-jev-compaction-agent",
  "version": "0.3.0",
  "description": "Portable Agent MCP plugin for verbatim Jev-guided transcript compaction.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "plugin.json", ".codex-plugin/plugin.json", "mcp.json", ".mcp.json", "skills", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "validate:portable": "node scripts/validate-plugin.mjs",
    "demo": "tsx examples/demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
